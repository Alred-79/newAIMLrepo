# ClinEQ Environment Variables
# Copy this to .env and fill in your values

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Tier-1 bias classifier: ollama (default when unset or empty) or kev.
# Any other value makes Tier-1 abstain (uncertain) and escalate.
LIGHTWEIGHT_BACKEND=ollama
# Optional: Kev settings, read only when LIGHTWEIGHT_BACKEND=kev.
# KEV_BASE_URL=http://127.0.0.1:8009
# KEV_API_KEY=
# KEV_MODEL=kev-latest
# Record the exact checkpoint/revision used to start your Kev server.
# KEV_CHECKPOINT=
# KEV_TIMEOUT_SECONDS=1.5

# API keys (not needed for local mode)
OPENAI_API_KEY=
TOGETHERAI_API_KEY=
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:dev@localhost:5433/clineq

# Redis
REDIS_URL=redis://localhost:6379
